# Copy to .env and fill in. Never commit .env.
# Generate a strong value in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Interface the API listens on. 127.0.0.1 = this PC only (Phase 2 default).
# For phone pairing (Phase 3) set it to this PC's LAN IP, e.g. 192.168.1.20.
BIND_ADDRESS=127.0.0.1
DB_PORT=5432

# ---- Used only when running the backend directly with Node (not Docker) ----
# DATABASE_URL=postgres://smsgw:<POSTGRES_PASSWORD>@localhost:5432/smsgw
# TEST_DATABASE_URL=postgres://smsgw:<POSTGRES_PASSWORD>@localhost:5432/smsgw_test
# HOST=127.0.0.1
# PORT=8443

# ---- Optional ----
LOG_LEVEL=info
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300
# API docs at /docs (off by default in production)
ENABLE_API_DOCS=true
# HTTPS on your LAN: create with  cd backend; npm run cert -- --ip <PC LAN IP>
# Paths are inside the container.
# TLS_CERT_PATH=/app/certs/server.crt
# TLS_KEY_PATH=/app/certs/server.key
# COOKIE_SECURE=true
# Address phones use to reach this server (goes into the pairing QR), e.g. https://192.168.1.20:8443
# PUBLIC_URL=
# Create this super administrator at first start if none exists (password printed once in the log)
# BOOTSTRAP_ADMIN_EMAIL=
# Requests per minute allowed per paired phone
GATEWAY_RATE_LIMIT_PER_MINUTE=600
# Background jobs (lease sweeper, scheduler, retention). Leave on.
RUN_WORKERS=true
