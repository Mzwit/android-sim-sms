<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <View android:id="@+id/statusDot" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/dot_grey" />
                    <TextView android:id="@+id/txtPhase" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:text="Stopped" />
                </LinearLayout>
                <TextView android:id="@+id/txtConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/txtCounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/txtInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" />
                <TextView android:id="@+id/txtError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textColor="@color/danger" android:visibility="gone" />

                <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/start" />
                <LinearLayout android:id="@+id/groupRunning" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnPause" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="@string/pause" />
                        <Button android:id="@+id/btnStop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/stop" />
                    </LinearLayout>
                    <Button android:id="@+id/btnEmergency" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:backgroundTint="@color/danger" android:text="@string/emergency" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="@string/honesty_note" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setup_title" />
                <TextView android:id="@+id/txtServer" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnPair" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/pair" />
                <TextView android:id="@+id/txtSim" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnSim" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/choose_sim" />
                <TextView android:id="@+id/txtPermissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnPermissions" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/grant_permissions" />
                <TextView android:id="@+id/txtBattery" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/battery_warning" android:textColor="@color/warn" />
                <Button android:id="@+id/btnDiagnostics" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/diagnostics" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
