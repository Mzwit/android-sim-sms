{
  "name": "smsgw-backend",
  "version": "0.2.0",
  "description": "Android SIM SMS Gateway — PC backend (Fastify + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "migrate:prod": "node dist/src/cli/migrate.js",
    "admin:create": "tsx src/cli/create-admin.ts",
    "admin:create:prod": "node dist/src/cli/create-admin.js",
    "seed": "tsx src/cli/seed.ts",
    "openapi": "tsx src/cli/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@node-rs/argon2": "^2.2.2",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
